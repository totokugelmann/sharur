# Sharur SAIC - .env.example
# Copiar a .env y completar con valores reales. Nunca versionar el .env real.

APP_ENV=development

DATABASE_URL=postgresql+psycopg2://sharur:sharur@localhost:5432/sharur_saic

SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=sharur-qwen
OLLAMA_TIMEOUT=600

NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=

NETWORK_CONTROL_BACKEND=iptables

EVIDENCE_STORAGE_DIR=./evidence_storage
REPORTS_DIR=./reports

LOG_LEVEL=INFO
LOG_DIR=./logs
